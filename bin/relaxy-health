const cpuSnapshot = async () =>
{
    const stat = await readText('/proc/stat');

    if (!stat)
    {
        return null;
    }

    const cpus = stat.split('\n')
                     .filter((line) => /^cpu\d*\s/.test(line))
                     .map((line) =>
                     {
                         const [, ...fields] = line.trim().split(/\s+/);
                         const [user, nice, system, idle, iowait, irq, softirq, steal] = fields.map(Number);

                         return {
                             idle:  idle + iowait,
                             total: user + nice + system + idle + iowait + irq + softirq + steal
                         };
                     });

    const procs = stat.match(/^procs_running (\d+)/m)?.[1];

    return {
        cpus,
        running: procs
                     ? Number(procs)
                     : null
    };
};

const busyBetween = (before, after) =>
{
    if (!before || !after)
    {
        return null;
    }

    const total = after.total - before.total;

    if (total <= 0)
    {
        return null;
    }

    return Math.round((100 * (total - (after.idle - before.idle))) / total);
};

const netSnapshot = async () =>
{
    const raw = await readText('/proc/net/dev');

    if (!raw)
    {
        return {};
    }

    const entries = raw.split('\n').slice(2)
                       .map((line) => line.trim())
                       .filter(Boolean)
                       .map((line) =>
                       {
                           const [name, rest] = line.split(':');
                           const fields = rest.trim().split(/\s+/).map(Number);

                           return [
                               name.trim(),
                               {
                                   rx: fields[0],
                                   tx: fields[8]
                               }
                           ];
                       })
                       .filter(([name]) => name !== 'lo');

    return Object.fromEntries(entries);
};

const readProcesses = async (previous, elapsedSeconds) =>
{
    const { readdir } = require('node:fs/promises');
    const pids = (await readdir('/proc').catch(() => []))
        .filter((entry) => /^\d+$/.test(entry));

    const current = new Map();
    const rows = [];

    const CHUNK = 40;

    const readOne = async (pid) =>
    {
        const stat = await readText(`/proc/${pid}/stat`);

        if (!stat)
        {
            return;
        }

        const close = stat.lastIndexOf(')');
        const name = stat.slice(stat.indexOf('(') + 1, close);
        const fields = stat.slice(close + 2).split(' ');

        const utime = Number(fields[11]);
        const stime = Number(fields[12]);
        const rssPages = Number(fields[21]);
        const jiffies = utime + stime;

        current.set(pid, jiffies);

        const before = previous?.get(pid);
        const cpuPercent = before != null && elapsedSeconds > 0
            ? round((100 * (jiffies - before)) / (CLK_TCK * elapsedSeconds), 1)
            : null;

        rows.push({
            pid:   Number(pid),
            name,
            cpuPercent,
            memMb: round((rssPages * 4096) / 1048576, 1)
        });
    };

    for (let index = 0; index < pids.length; index += CHUNK)
    {
        await Promise.all(pids.slice(index, index + CHUNK).map(readOne));

        await new Promise((resolve) => setImmediate(resolve));
    }

    rows.sort((a, b) => (b.cpuPercent ?? -1) - (a.cpuPercent ?? -1) || b.memMb - a.memMb);

    return {
        snapshot: current,
        top:      rows.slice(0, 15),
        total:    rows.length
    };
};

const readDisks = async () =>
{
    const result = await run('/usr/bin/df', [
        '-B1',
        '--output=target,size,used,pcent',
        '/',
        '/boot'
    ]);

    if (!result.ok)
    {
        return [];
    }

    return result.stdout.split('\n').slice(1)
                 .map((line) => line.trim().split(/\s+/))
                 .filter((fields) => fields.length >= 4)
                 .map(([mount, size, used, percent]) => ({
                     mount,
                     sizeGb:  round(Number(size) / 1024 ** 3, 1),
                     usedGb:  round(Number(used) / 1024 ** 3, 1),
                     percent: Number(String(percent).replace('%', ''))
                 }));
};

const readTemperature = async () =>
{
    const raw = await readText('/sys/class/thermal/thermal_zone0/temp');
    const value = Number(raw?.trim());

    return Number.isFinite(value) && value > 0
        ? round(value > 1000
            ? value / 1000
            : value, 1)
        : null;
};

const readUndervoltage = async () =>
{
    const { readdir } = require('node:fs/promises');
    const hwmons = await readdir('/sys/class/hwmon').catch(() => []);

    for (const entry of hwmons)
    {
        const name = (await readText(`/sys/class/hwmon/${entry}/name`))?.trim();

        if (name !== 'rpi_volt')
        {
            continue;
        }

        const alarm = (await readText(`/sys/class/hwmon/${entry}/in0_lcrit_alarm`))?.trim();

        if (alarm == null)
        {
            return null;
        }

        return { detected: alarm === '1' };
    }

    return null;
};

const readCpuFreq = async () =>
{
    const [current, min, max, governor] = await Promise.all([
        readText('/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq'),
        readText('/sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq'),
        readText('/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq'),
        readText('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor')
    ]);

    const mhz = (value) => (value
        ? Math.round(Number(value.trim()) / 1000)
        : null);

    return {
        currentMhz: mhz(current),
        minMhz:     mhz(min),
        maxMhz:     mhz(max),
        governor:   governor?.trim() ?? null
    };
};

const readMemory = async () =>
{
    const raw = await readText('/proc/meminfo') ?? '';
    const kb = (key) => Number(raw.match(new RegExp(`^${key}:\\s+(\\d+)`, 'm'))?.[1]);
    const gb = (value) => round(value / 1048576, 2);

    const total = kb('MemTotal') || 0;
    const available = kb('MemAvailable') ?? 0;
    const swapTotal = kb('SwapTotal') || 0;
    const swapFree = kb('SwapFree') || 0;

    return {
        memory: {
            totalGb:     gb(total),
            usedGb:      gb(total - available),
            availableGb: gb(available),
            buffCacheGb: gb((kb('Buffers') || 0) + (kb('Cached') || 0)),
            percent:     total
                             ? Math.round((100 * (total - available)) / total)
                             : null
        },
        swap:   {
            totalGb: gb(swapTotal),
            usedGb:  gb(swapTotal - swapFree),
            percent: swapTotal
                         ? Math.round((100 * (swapTotal - swapFree)) / swapTotal)
                         : null
        }
    };
};

const readModel = async () =>
{
    const raw = await readText('/proc/device-tree/model');

    return raw
        ? raw.replace(/\0/g, '').trim()
        : null;
};

const readOsName = async () =>
{
    const raw = await readText('/etc/os-release');

    return raw?.match(/^PRETTY_NAME="?([^"\n]+)"?/m)?.[1] ?? `${os.type()} ${os.release()}`;
};

const loadState = async () =>
{
    const raw = await readText(STATE_FILE);

    try
    {
        return raw
            ? JSON.parse(raw)
            : {};
    }
    catch
    {
        return {};
    }
};

const writeJson = async (file, payload, mode = 0o644) =>
{
    const temporary = `${file}.tmp`;

    await mkdir(path.dirname(file), { recursive: true }).catch(() => {});
    await writeFile(temporary, `${JSON.stringify(payload, null, 2)}\n`, {
        encoding: 'utf8',
        mode
    });
    await rename(temporary, file);
};

const main = async () =>
{
    let state = await loadState();

    const ledger = createLedger({
        stateFile:  UPTIME_STATE_FILE,
        notesFile:  UPTIME_NOTES_FILE,
        publicFile: UPTIME_PUBLIC_FILE
    });

    await ledger.load().catch((error) =>
    {
        console.error(`[relaxy-health] uptime ledger failed to load: ${error.message}`);
    });

    const announcer = createAnnouncer({ statusFile: STATUS_FILE });

    let previousCpu = await cpuSnapshot();
    let previousNet = await netSnapshot();
    let previousProcs = null;
    let previousAt = Date.now();
    let previousHeavyAt = null;
    let tickCount = 0;

    const model = await readModel();
    const osName = await readOsName();

    let heavy = {
        procs:      {
            snapshot: null,
            top:      [],
            total:    0
        },
        containers: {},
        tmux:       new Set(),
        disks:      []
    };

    const tick = async () =>
    {
        const now = Date.now();
        const elapsedSeconds = Math.max(1, (now - previousAt) / 1000);

        tickCount += 1;

        const status = await readFleetStatus(now);

        const runitNames = [...new Set(SERVICES.map((service) => service.runit).filter(Boolean))];

        const [
            currentCpu, currentNet, runit, temperature, freq, memory, undervoltage
        ] = await Promise.all([
            cpuSnapshot(),
            netSnapshot(),
            readRunit(runitNames),
            readTemperature(),
            readCpuFreq(),
            readMemory(),
            readUndervoltage()
        ]);

        const {
            procs,
            containers,
            tmux,
            disks
        } = heavy;

        const services = await Promise.all(SERVICES.map(async (service) =>
        {
            const runitState = service.runit
                ? runit[service.runit] ?? null
                : null;
            const container = service.container
                ? containers[service.container] ?? null
                : null;
            const inTmux = service.tmux
                ? tmux.has(service.tmux)
                : null;

            let online = null;
            let detail = null;
            let latencyMs = null;
            let latencyAt = null;
            let meta = null;

            if (service.probe)
            {
                const result = await service.probe({
                                                now,
                                                status
                                            })
                                            .catch(() => ({
                                                ok:     false,
                                                detail: 'probe threw'
                                            }));

                online = result.ok;
                detail = result.detail ?? null;
                latencyMs = result.ms ?? null;

                latencyAt = result.at ?? null;
                meta = result.meta ?? null;
            }
            else if (runitState)
            {

                online = runitState.state === 'run';

                const machineUptime = os.uptime();
                const age = runitState.forSeconds;

                detail = age != null && age <= machineUptime
                    ? `${runitState.state} for ${formatDuration(age)}`
                    : runitState.state === 'run'
                        ? 'running since boot'
                        : runitState.state;
            }
            else if (container)
            {
                online = container.state === 'running';
                detail = container.status;
            }

            const previousEntry = state[service.key];
            const changed = !previousEntry || previousEntry.online !== online;

            return {
                key:      service.key,
                name:     service.name,
                category: service.category,
                critical: Boolean(service.critical),
                public:   Boolean(service.public),

                remote:     Boolean(service.remote),
                causeHint:  service.causeHint ?? null,
                online,
                detail,
                latencyMs,
                latencyAt,
                meta,
                since:      changed
                                ? new Date(now).toISOString()
                                : previousEntry.since,
                supervisor: runitState
                                ? { kind: 'runit', ...runitState }
                                : container
                        ? { kind: 'podman', ...container }
                        : inTmux != null
                            ? {
                                kind:  'tmux',
                                state: inTmux
                                           ? 'run'
                                           : 'down'
                            }
                            : null
            };
        }));

        state = Object.fromEntries(services.map((service) => [
            service.key,
            {
                online: service.online,
                since:  service.since
            }
        ]));

        const perCore = currentCpu?.cpus.slice(1).map((core, index) => busyBetween(previousCpu?.cpus[index + 1], core)) ?? [];

        const network = Object.entries(currentNet).map(([iface, counters]) => ({
            iface,
            rxBytes: counters.rx,
            txBytes: counters.tx,
            rxKbps:  previousNet[iface]
                         ? round(((counters.rx - previousNet[iface].rx) * 8) / 1000 / elapsedSeconds, 1)
                         : null,
            txKbps:  previousNet[iface]
                         ? round(((counters.tx - previousNet[iface].tx) * 8) / 1000 / elapsedSeconds, 1)
                         : null
        }));

        const watchdogRaw = await readText(WATCHDOG_FILE);
        let watchdog = null;

        try
        {
            watchdog = watchdogRaw
                ? JSON.parse(watchdogRaw)
                : null;
        }
        catch
        {
            watchdog = null;
        }

        const counted = services.filter((service) => service.online !== null);

        const payload = {
            generatedAt: new Date(now).toISOString(),
            summary:     {
                total:           services.length,
                online:          counted.filter((service) => service.online).length,
                offline:         counted.filter((service) => !service.online).length,
                unknown:         services.length - counted.length,
                criticalOffline: services
                                     .filter((service) => service.critical && service.online === false)
                                     .map((service) => service.key)
            },
            system:      {
                host:          os.hostname(),
                model,
                os:            osName,
                kernel:        os.release(),
                arch:          typeof os.machine === 'function'
                                   ? os.machine()
                                   : os.arch(),
                uptimeSeconds: Math.floor(os.uptime()),
                loadAverage:   os.loadavg().map((value) => round(value, 2)),
                temperatureC:  temperature,
                undervoltage,
                cpu:           {
                    cores:            os.cpus().length,
                    busyPercent:      busyBetween(previousCpu?.cpus[0], currentCpu?.cpus[0]),
                    perCorePercent:   perCore,
                    runningProcesses: currentCpu?.running ?? null, ...freq
                }, ...memory,
                disks,
                network,
                processes:     {
                    total: procs.total,
                    top:   procs.top
                }
            },
            services,
            watchdog
        };

        await writeJson(FULL_OUTPUT, payload);

        const publicServices = services
            .filter((service) => service.public)
            .map((service) => ({
                key:       service.key,
                name:      service.name,
                category:  service.category,
                online:    service.online,
                since:     service.since,
                latencyMs: service.latencyMs,
                latencyAt: service.latencyAt,

                meta: service.meta
            }));

        await writeJson(PUBLIC_OUTPUT, {
            generatedAt: payload.generatedAt,
            services:    publicServices
        });

        await writeJson(STATE_FILE, state).catch(() => {});

        try
        {
            ledger.record({
                now,
                services,
                system: payload.system,
                watchdog
            });

            const incidentChanged = ledger.hasPendingIncidentChange();

            const every = ledger.hasOngoing()
                ? UPTIME_PUBLISH_EVERY_ACTIVE
                : UPTIME_PUBLISH_EVERY;

            if (incidentChanged || tickCount % every === 0)
            {
                const published = await ledger.publish({
                    now,
                    publicServices
                });

                await ledger.flush({ force: incidentChanged });

                await announcer.sync(published, now);
            }
        }
        catch (error)
        {
            console.error(`[relaxy-health] uptime ledger failed: ${error.message}`);
        }

        previousCpu = currentCpu ?? previousCpu;
        previousNet = Object.keys(currentNet).length
            ? currentNet
            : previousNet;

        previousAt = now;
    };

    const collectors = {
        containers: async () => { heavy.containers = await readPodman(); },
        tmux:       async () => { heavy.tmux = await readTmux(); },
        disks:      async () => { heavy.disks = await readDisks(); },
        procs:      async () =>
                    {
                        const now = Date.now();
                        const elapsed = previousHeavyAt
                            ? (now - previousHeavyAt) / 1000
                            : 60;
                        const procs = await readProcesses(previousProcs, elapsed);

                        heavy.procs = procs;
                        previousProcs = procs.snapshot;
                        previousHeavyAt = now;
                    }
    };

    COLLECTORS.forEach(({
        key,
        intervalMs,
        offsetMs
    }, index) =>
    {
        const runCollector = () => collectors[key]().catch((error) =>
        {
            console.error(`[relaxy-health] collector ${key} failed: ${error.message}`);
        });

        setTimeout(runCollector, (index + 1) * 2000);

        setTimeout(() => setInterval(runCollector, intervalMs), offsetMs);
    });

    const history = [];
    let vitalsPrevCpu = previousCpu;
    let vitalsPrevNet = previousNet;
    let vitalsPrevAt = Date.now();

    const vitalsTick = async () =>
    {
        const now = Date.now();
        const seconds = Math.max(0.5, (now - vitalsPrevAt) / 1000);

        const [currentCpu, currentNet, temperature, memory, freq] = await Promise.all([
            cpuSnapshot(),
            netSnapshot(),
            readTemperature(),
            readMemory(),
            readCpuFreq()
        ]);

        let rxKbps = null;
        let txKbps = null;

        const primary = Object.entries(currentNet)
                              .filter(([iface]) => iface !== 'lo')
                              .sort((a, b) => (b[1].rx + b[1].tx) - (a[1].rx + a[1].tx))[0];

        if (primary)
        {
            const [iface, counters] = primary;
            const before = vitalsPrevNet[iface];

            if (before)
            {

                rxKbps = round(Math.max(0, (counters.rx - before.rx) * 8) / 1000 / seconds, 1);
                txKbps = round(Math.max(0, (counters.tx - before.tx) * 8) / 1000 / seconds, 1);
            }
        }

        const sample = {
            t:     now,
            cpu:   busyBetween(vitalsPrevCpu?.cpus[0], currentCpu?.cpus[0]),
            cores: currentCpu?.cpus.slice(1).map((core, index) => busyBetween(vitalsPrevCpu?.cpus[index + 1], core)) ?? [],
            mem:   memory.memory.percent,
            temp:  temperature,
            load:  round(os.loadavg()[0], 2),
            rxKbps,
            txKbps,
            mhz:   freq.currentMhz
        };

        history.push(sample);

        while (history.length > VITALS_HISTORY)
        {
            history.shift();
        }

        vitalsPrevCpu = currentCpu ?? vitalsPrevCpu;
        vitalsPrevNet = Object.keys(currentNet).length
            ? currentNet
            : vitalsPrevNet;
        vitalsPrevAt = now;

        await writeJson(VITALS_OUTPUT, {
            generatedAt: new Date(now).toISOString(),
            intervalMs:  VITALS_INTERVAL_MS,
            current:     sample,
            history
        }).catch(() => {});
    };

    await tick();
    await new Promise((resolve) => setTimeout(resolve, 2000));
    await tick();
    await vitalsTick();

    console.log(`[relaxy-health] publishing ${FULL_OUTPUT} every ${INTERVAL_MS}ms`);

    const loop = async () =>
    {
        try
        {
            await tick();
        }
        catch (error)
        {
            console.error(`[relaxy-health] tick failed: ${error.stack ?? error}`);
        }
    };

    setInterval(loop, INTERVAL_MS);

    setInterval(() =>
    {
        vitalsTick().catch((error) =>
        {
            console.error(`[relaxy-health] vitals tick failed: ${error.stack ?? error}`);
        });
    }, VITALS_INTERVAL_MS);

    for (const signal of [
        'SIGINT',
        'SIGTERM'
    ])
    {
        process.on(signal, () =>
        {
            console.log(`[relaxy-health] ${signal} - stopping.`);

            setTimeout(() => process.exit(0), 2000).unref();

            ledger.flush({ force: true })
                  .catch(() => {})
                  .finally(() => process.exit(0));
        });
    }
};

main().catch((error) =>
{
    console.error(`[relaxy-health] fatal: ${error.stack ?? error}`);
    process.exit(1);
});
