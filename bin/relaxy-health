const STATUS_STALE_MS = 90 * 1000;

const CLK_TCK = 100;

const readFleetStatus = async (now) =>
{
    const raw = await readText(STATUS_FILE);

    if (!raw)
    {
        return {
            ok:     false,
            reason: 'missing',
            ageMs:  null,
            data:   null
        };
    }

    let data = null;

    try
    {
        data = JSON.parse(raw);
    }
    catch
    {
        return {
            ok:     false,
            reason: 'unparseable',
            ageMs:  null,
            data:   null
        };
    }

    const ageMs = Math.max(0, now - Date.parse(data.generatedAt));

    if (!Number.isFinite(ageMs))
    {
        return {
            ok:     false,
            reason: 'undated',
            ageMs:  null,
            data
        };
    }

    if (ageMs > STATUS_STALE_MS)
    {
        return {
            ok:     false,
            reason: 'stale',
            ageMs,
            data
        };
    }

    return {
        ok:     true,
        reason: null,
        ageMs,
        data
    };
};

const fleetBlind = (status) =>
{
    if (!status.data)
    {

        return {
            ok:     false,
            detail: `status.json ${status.reason}`
        };
    }

    if (!status.ok)
    {
        return {
            ok:     null,
            detail: `status.json ${status.reason}${status.ageMs != null
                ? ` (${Math.round(status.ageMs / 1000)}s old)`
                : ''}`
        };
    }

    return null;
};

const managerMeta = (bot) =>
{
    const machines = Array.isArray(bot.machines)
        ? bot.machines
        : [];

    const primary = machines.find((machine) => machine.id === bot.primary) ?? machines.find((machine) => machine.online === true) ?? null;

    const latency = primary?.latency ?? {};

    const number = (value) => (Number.isFinite(value)
        ? value
        : null);

    return {

        machines:      (bot.hostCount ?? 0) > 1
                           ? bot.hostCount
                           : null,
        shards:        primary
                           ? (primary.shards ?? []).length
                           : number(bot.totalShards),
        clusters:      primary?.clusters ?? number(bot.totalClusters),
        clustersReady: number(primary?.clustersReady),
        guilds:        number(bot.totalGuilds),

        worstShardMs: number(latency.worstShardMs ?? bot.worstShardMs),
        databaseMs:   number(latency.databaseMs),
        heartbeatMs:  number(latency.heartbeatMs),
        startedAt:    primary?.startedAt ?? null,
        version:      primary?.version ?? null
    };
};

const fleetLatency = (ms, at) => ({
    ms: Number.isFinite(ms) && ms >= 0
            ? ms
            : null,

    at: at
            ? Date.parse(at) || null
            : null
});

const round = (value, digits = 0) =>
{
    const factor = 10 ** digits;
    return Math.round(value * factor) / factor;
};

const run = (command, args, timeout = PROBE_TIMEOUT_MS) => new Promise((resolve) =>
{
    execFile(command, args, {
        timeout,
        encoding: 'utf8'
    }, (error, stdout, stderr) =>
    {
        resolve({
            ok:     !error,
            code:   error?.code ?? 0,
            stdout: stdout ?? '',
            stderr: stderr ?? ''
        });
    });
});

const readText = (file) => readFile(file, 'utf8').catch(() => null);

const formatDuration = (seconds) =>
{
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);

    if (days > 0)
    {
        return `${days}d ${hours}h`;
    }

    return hours > 0
        ? `${hours}h ${minutes}m`
        : `${minutes}m`;
};

const probeTcp = (port, host = '127.0.0.1') => new Promise((resolve) =>
{
    const started = Date.now();
    const socket = new net.Socket();
    let settled = false;

    const finish = (ok) =>
    {
        if (settled)
        {
            return;
        }

        settled = true;
        socket.destroy();
        resolve({
            ok,
            ms: Date.now() - started
        });
    };

    socket.setTimeout(PROBE_TIMEOUT_MS);
    socket.once('connect', () => finish(true));
    socket.once('timeout', () => finish(false));
    socket.once('error', () => finish(false));
    socket.connect(port, host);
});

const probeHttp = async (url, {
    expect = null,
    accept = null,
    headers = {},
    redirect = 'follow'
} = {}) =>
{
    const started = Date.now();
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), PROBE_TIMEOUT_MS);

    try
    {
        const response = await fetch(url, {
            signal:  controller.signal,
            redirect,
            headers: { 'user-agent': 'relaxy-health/1', ...headers }
        });

        const statusOk = accept
            ? accept.includes(response.status)
            : response.status < 500;

        if (!statusOk)
        {
            return {
                ok:     false,
                ms:     Date.now() - started,
                detail: `HTTP ${response.status}`
            };
        }

        if (expect)
        {
            const body = await response.text();

            if (!body.includes(expect))
            {
                return {
                    ok:     false,
                    ms:     Date.now() - started,
                    detail: 'unexpected body'
                };
            }
        }

        return {
            ok:     true,
            ms:     Date.now() - started,
            detail: `HTTP ${response.status}`
        };
    }
    catch (error)
    {
        return {
            ok:     false,
            ms:     Date.now() - started,
            detail: error.name === 'AbortError'
                        ? 'timeout'
                        : error.message
        };
    }
    finally
    {
        clearTimeout(timer);
    }
};

const probeDns = async (server, port, name = 'relaxy.xyz') =>
{
    const started = Date.now();
    const resolver = new dns.Resolver({
        timeout: PROBE_TIMEOUT_MS,
        tries:   1
    });

    resolver.setServers([
        port === 53
            ? server
            : `${server}:${port}`
    ]);

    try
    {
        const addresses = await new Promise((resolve, reject) =>
        {
            resolver.resolve4(name,
                (error, result) => (error
                    ? reject(error)
                    : resolve(result)));
        });

        const ms = Date.now() - started;

        return {
            ok:     Array.isArray(addresses) && addresses.length > 0,
            ms,
            detail: `answered in ${ms}ms`
        };
    }
    catch (error)
    {
        const ms = Date.now() - started;

        if (error.code === 'ENODATA' || error.code === 'ENOTFOUND')
        {
            return {
                ok:     true,
                ms,
                detail: `answered (${error.code}) in ${ms}ms`
            };
        }

        return {
            ok:     false,
            ms,
            detail: error.code ?? 'query failed'
        };
    }
};

const readRunit = async (names) =>
{

    const result = await run('/usr/bin/sudo', [
        '-n',
        '/usr/bin/sv',
        'status',
        ...names
    ]);
    const text = `${result.stdout}${result.stderr}`.trim();

    if (!result.ok && /a password is required|not allowed/i.test(text))
    {
        return Object.fromEntries(names.map((name) => [
            name,
            null
        ]));
    }

    const lines = text.split('\n').map((line) => line.trim()).filter(Boolean);
    const entries = names.map((name) =>
    {
        const line = lines.find((candidate) => new RegExp(`^\\w+:\\s*${name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}:`).test(candidate));

        if (!line)
        {
            return [
                name,
                null
            ];
        }

        const match = line.match(/^(\w+):\s*\S+:\s*(?:\(pid (\d+)\)\s*)?(\d+)s/);

        return [
            name,
            {
                state:      match?.[1] ?? (line.split(':')[0] || 'unknown'),
                pid:        match?.[2]
                                ? Number(match[2])
                                : null,
                forSeconds: match?.[3]
                                ? Number(match[3])
                                : null,
                raw:        line
            }
        ];
    });

    return Object.fromEntries(entries);
};

const readPodman = async () =>
{
    const result = await run('/usr/bin/podman', [
        'ps',
        '--all',
        '--format',
        'json'
    ], 8000);

    if (!result.ok)
    {
        return {};
    }

    try
    {
        const rows = JSON.parse(result.stdout);
        const entries = rows.map((row) =>
        {
            const name = Array.isArray(row.Names)
                ? row.Names[0]
                : row.Names;

            return [
                name,
                {
                    state:        row.State,
                    status:       row.Status,
                    image:        row.Image,
                    startedAt:    row.StartedAt ?? null,
                    exitCode:     row.ExitCode ?? null,
                    restartCount: row.RestartCount ?? 0
                }
            ];
        });

        return Object.fromEntries(entries);
    }
    catch
    {
        return {};
    }
};

const readTmux = async () =>
{
    const result = await run('/usr/bin/tmux', [
        'list-sessions',
        '-F',
        '#{session_name}'
    ]);

    return result.ok
        ? new Set(result.stdout.split('\n').map((line) => line.trim()).filter(Boolean))
        : new Set();
};

